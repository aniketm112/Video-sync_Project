# Firebase web app configuration for the Video Sync app.
# Copy this file to `.env` and fill in the real values from:
# Firebase console -> Project settings -> General -> Your apps -> Web app -> "SDK setup and configuration"
#
# These values identify your Firebase project and are safe to expose in client
# code. Access control comes from security rules (see database.rules.json at
# the repo root), not from keeping this file secret. Never put private
# admin/service-account credentials in this file.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
